{
  "folders": [
    { "name": "00 - Inicio", "path": "." },
    { "name": "01 - Nucleo asincrono", "path": "core" },
    { "name": "02 - API local", "path": "api" },
    { "name": "03 - Servidor Django", "path": "thorn_web" },
    { "name": "04 - HUD visual", "path": "frontend" },
    { "name": "05 - Herramientas", "path": "tools" },
    { "name": "06 - Pruebas", "path": "tests" },
    { "name": "07 - Documentacion", "path": "docs" },
    { "name": "08 - Perfil de IA", "path": "models" },
    { "name": "09 - GitHub y CI", "path": ".github" },
    { "name": "10 - Hooks de Git", "path": ".githooks" }
  ],
  "settings": {
    "window.title": "${dirty}${activeEditorShort}${separator}T.H.O.R.N | Bastion 9${separator}${appName}",
    "explorer.compactFolders": false,
    "explorer.sortOrder": "default",
    "explorer.excludeGitIgnore": true,
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.expand": false,
    "explorer.fileNesting.patterns": {
      "requirements.txt": "requirements.in, requirements-*.in, requirements-*.txt",
      "package.json": "package-lock.json"
    },
    "files.exclude": {
      "core": { "when": "THORN.code-workspace" },
      "api": { "when": "THORN.code-workspace" },
      "thorn_web": { "when": "THORN.code-workspace" },
      "frontend": { "when": "THORN.code-workspace" },
      "tools": { "when": "THORN.code-workspace" },
      "tests": { "when": "THORN.code-workspace" },
      "docs": { "when": "THORN.code-workspace" },
      "models": { "when": "THORN.code-workspace" },
      ".github": { "when": "THORN.code-workspace" },
      ".githooks": { "when": "THORN.code-workspace" },
      "**/.git": true,
      "**/.vscode": true,
      "**/.venv": true,
      "**/.tools": true,
      "**/.models": true,
      "**/.artifacts": true,
      "**/__pycache__": true,
      "**/node_modules": true,
      "**/dist": true,
      "**/build": true,
      "**/data": true,
      "**/backups": true,
      "**/logs": true,
      "**/.env": true,
      "**/*.lnk": true
    },
    "files.watcherExclude": {
      "**/.git/objects/**": true,
      "**/.venv/**": true,
      "**/.tools/**": true,
      "**/.models/**": true,
      "**/.artifacts/**": true,
      "**/node_modules/**": true,
      "**/dist/**": true,
      "**/build/**": true,
      "**/data/**": true,
      "**/backups/**": true,
      "**/logs/**": true
    },
    "search.exclude": {
      "**/.venv/**": true,
      "**/.tools/**": true,
      "**/.models/**": true,
      "**/.artifacts/**": true,
      "**/node_modules/**": true,
      "**/dist/**": true,
      "**/build/**": true,
      "**/data/**": true,
      "**/backups/**": true,
      "**/logs/**": true
    },
    "python.defaultInterpreterPath": "${workspaceFolder:00 - Inicio}/.venv/Scripts/python.exe",
    "python.analysis.extraPaths": ["${workspaceFolder:00 - Inicio}"],
    "python.terminal.executeInFileDir": false,
    "terminal.integrated.cwd": "${workspaceFolder:00 - Inicio}",
    "npm.autoDetect": "off"
  },
  "extensions": {
    "recommendations": [
      "ms-python.python",
      "ms-python.vscode-pylance",
      "ms-python.debugpy"
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "THORN: pruebas Python",
        "type": "process",
        "command": "${workspaceFolder:00 - Inicio}/.venv/bin/python",
        "windows": { "command": "${workspaceFolder:00 - Inicio}/.venv/Scripts/python.exe" },
        "args": ["-W", "error::ResourceWarning", "-m", "unittest", "discover", "-s", "tests", "-v"],
        "options": { "cwd": "${workspaceFolder:00 - Inicio}" },
        "group": { "kind": "test", "isDefault": true },
        "problemMatcher": [],
        "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
      },
      {
        "label": "THORN: comprobar Django",
        "type": "process",
        "command": "${workspaceFolder:00 - Inicio}/.venv/bin/python",
        "windows": { "command": "${workspaceFolder:00 - Inicio}/.venv/Scripts/python.exe" },
        "args": ["manage.py", "check"],
        "options": { "cwd": "${workspaceFolder:00 - Inicio}" },
        "problemMatcher": []
      },
      {
        "label": "THORN: revisar archivos para GitHub",
        "type": "process",
        "command": "${workspaceFolder:00 - Inicio}/.venv/bin/python",
        "windows": { "command": "${workspaceFolder:00 - Inicio}/.venv/Scripts/python.exe" },
        "args": ["tools/check_repository.py", "--working-tree"],
        "options": { "cwd": "${workspaceFolder:00 - Inicio}" },
        "problemMatcher": []
      },
      {
        "label": "THORN: pruebas HUD",
        "type": "shell",
        "command": "npm",
        "windows": { "command": "npm.cmd" },
        "args": ["test"],
        "options": { "cwd": "${workspaceFolder:00 - Inicio}/frontend" },
        "group": "test",
        "problemMatcher": []
      },
      {
        "label": "THORN: compilar HUD",
        "type": "shell",
        "command": "npm",
        "windows": { "command": "npm.cmd" },
        "args": ["run", "build"],
        "options": { "cwd": "${workspaceFolder:00 - Inicio}/frontend" },
        "group": { "kind": "build", "isDefault": true },
        "problemMatcher": []
      },
      {
        "label": "THORN: demo del nucleo sin MySQL",
        "type": "process",
        "command": "${workspaceFolder:00 - Inicio}/.venv/bin/python",
        "windows": { "command": "${workspaceFolder:00 - Inicio}/.venv/Scripts/python.exe" },
        "args": ["main.py", "--demo", "--sin-db"],
        "options": { "cwd": "${workspaceFolder:00 - Inicio}" },
        "problemMatcher": []
      }
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "THORN: API de desarrollo (8005)",
        "type": "debugpy",
        "request": "launch",
        "python": "${workspaceFolder:00 - Inicio}/.venv/bin/python",
        "windows": { "python": "${workspaceFolder:00 - Inicio}/.venv/Scripts/python.exe" },
        "program": "${workspaceFolder:00 - Inicio}/serve.py",
        "args": ["--port", "8005", "--sin-db"],
        "cwd": "${workspaceFolder:00 - Inicio}",
        "console": "integratedTerminal",
        "justMyCode": true
      },
      {
        "name": "THORN: demo del nucleo",
        "type": "debugpy",
        "request": "launch",
        "python": "${workspaceFolder:00 - Inicio}/.venv/bin/python",
        "windows": { "python": "${workspaceFolder:00 - Inicio}/.venv/Scripts/python.exe" },
        "program": "${workspaceFolder:00 - Inicio}/main.py",
        "args": ["--demo", "--sin-db"],
        "cwd": "${workspaceFolder:00 - Inicio}",
        "console": "integratedTerminal",
        "justMyCode": true
      }
    ]
  }
}
