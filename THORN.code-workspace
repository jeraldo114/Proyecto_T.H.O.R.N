{
  "folders": [
    { "name": "00 - Inicio", "path": "." },
    { "name": "01 - Nucleo asincrono", "path": "core" },
    { "name": "02 - API local", "path": "api" },
    { "name": "03 - Servidor Django", "path": "thorn_web" },
    { "name": "04 - HUD visual", "path": "frontend" },
    { "name": "05 - Herramientas", "path": "tools" },
    { "name": "06 - Pruebas", "path": "tests" },
    { "name": "07 - Documentacion", "path": "docs" },
    { "name": "08 - Perfil de IA", "path": "models" },
    { "name": "09 - GitHub y CI", "path": ".github" },
    { "name": "10 - Hooks de Git", "path": ".githooks" }
  ],
  "settings": {
    "window.title": "${dirty}${activeEditorShort}${separator}T.H.O.R.N | Bastion 9${separator}${appName}",
    "explorer.compactFolders": false,
    "explorer.sortOrder": "default",
    "explorer.excludeGitIgnore": true,
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.expand": false,
    "explorer.fileNesting.patterns": {
      "requirements.txt": "requirements.in, requirements-*.in, requirements-*.txt",
      "package.json": "package-lock.json"
    },
    "files.exclude": {
      "core": { "when": "THORN.code-workspace" },
      "api": { "when": "THORN.code-workspace" },
      "thorn_web": { "when": "THORN.code-workspace" },
      "frontend": { "when": "THORN.code-workspace" },
      "tools": { "when": "THORN.code-workspace" },
      "tests": { "when": "THORN.code-workspace" },
      "docs": { "when": "THORN.code-workspace" },
      "models": { "when": "THORN.code-workspace" },
      ".github": { "when": "THORN.code-workspace" },
      ".githooks": { "when": "THORN.code-workspace" },
      "**/.git": true,
      "**/.vscode": true,
      "**/.venv": true,
      "**/.tools": true,
      "**/.models": true,
      "**/.artifacts": true,
      "**/__pycache__": true,
      "**/node_modules": true,
      "**/dist": true,
      "**/build": true,
      "**/data": true,
      "**/backups": true,
      "**/logs": true,
      "**/.env": true,
      "**/*.lnk": true
    },
    "files.watcherExclude": {
      "**/.git/objects/**": true,
      "**/.venv/**": true,
      "**/.tools/**": true,
      "**/.models/**": true,
      "**/.artifacts/**": true,
      "**/node_modules/**": true,
      "**/dist/**": true,
      "**/build/**": true,
      "**/data/**": true,
      "**/backups/**": true,
      "**/logs/**": true
    },
    "search.exclude": {
      "**/.venv/**": true,
      "**/.tools/**": true,
      "**/.models/**": true,
      "**/.artifacts/**": true,
      "**/node_modules/**": true,
      "**/dist/**": true,
      "**/build/**": true,
      "**/data/**": true,
      "**/backups/**": true,
      "**/logs/**": true
    },
    "python.defaultInterpreterPath": "${workspaceFolder:00 - Inicio}/.venv/Scripts/python.exe",
    "python.analysis.extraPaths": ["${workspaceFolder:00 - Inicio}"],
    "python.terminal.executeInFileDir": false,
    "terminal.integrated.cwd": "${workspaceFolder:00 - Inicio}",
    "npm.autoDetect": "off"
  },
  "extensions": {
    "recommendations": [
      "ms-python.python",
      "ms-python.vscode-pylance",
      "ms-python.debugpy"
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "THORN: pruebas Python",
        "type": "process",
        "command": "${workspaceFolder:00 - Inicio}/.venv/bin/python",
        "windows": { "command": "${workspaceFolder:00 - Inicio}/.venv/Scripts/python.exe" },
        "args": ["-W", "error::ResourceWarning", "-m", "unittest", "discover", "-s", "tests", "-v"],
        "options": { "cwd": "${workspaceFolder:00 - Inicio}" },
        "group": { "kind": "test", "isDefault": true },
        "problemMatcher": [],
        "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
      },
      {
        "label": "THORN: comprobar Django",
        "type": "process",
        "command": "${workspaceFolder:00 - Inicio}/.venv/bin/python",
        "windows": { "command": "${workspaceFolder:00 - Inicio}/.venv/Scripts/python.exe" },
        "args": ["manage.py", "check"],
        "options": { "cwd": "${workspaceFolder:00 - Inicio}" },
        "problemMatcher": []
      },
      {
        "label": "THORN: revisar archivos para GitHub",
        "type": "process",
        "command": "${workspaceFolder:00 - Inicio}/.venv/bin/python",
        "windows": { "command": "${workspaceFolder:00 - Inicio}/.venv/Scripts/python.exe" },
        "args": ["tools/check_repository.py", "--working-tree"],
        "options": { "cwd": "${workspaceFolder:00 - Inicio}" },
        "problemMatcher": []
      },
      {
        "label": "THORN: pruebas HUD",
        "type": "shell",
        "command": "npm",
        "windows": { "command": "npm.cmd" },
        "args": ["test"],
        "options": { "cwd": "${workspaceFolder:00 - Inicio}/frontend" },
        "group": "test",
        "problemMatcher": []
      },
      {
        "label": "THORN: compilar HUD",
        "type": "shell",
        "command": "npm",
        "windows": { "command": "npm.cmd" },
        "args": ["run", "build"],
        "options": { "cwd": "${workspaceFolder:00 - Inicio}/frontend" },
        "group": { "kind": "build", "isDefault": true },
        "problemMatcher": []
      },
      {
        "label": "THORN: demo del nucleo sin MySQL",
        "type": "process",
        "command": "${workspaceFolder:00 - Inicio}/.venv/bin/python",
        "windows": { "command": "${workspaceFolder:00 - Inicio}/.venv/Scripts/python.exe" },
        "args": ["main.py", "--demo", "--sin-db"],
        "options": { "cwd": "${workspaceFolder:00 - Inicio}" },
        "problemMatcher": []
      },
      {
        "label": "THORN: crear audio de prueba",
        "detail": "Sintetiza con Piper local una frase en .artifacts/frase-prueba.wav para las pruebas de voz.",
        "type": "process",
        "command": "${workspaceFolder:00 - Inicio}/.venv/bin/python",
        "windows": { "command": "${workspaceFolder:00 - Inicio}/.venv/Scripts/python.exe" },
        "args": ["tools/make_voice_fixture.py"],
        "options": { "cwd": "${workspaceFolder:00 - Inicio}" },
        "problemMatcher": []
      },
      {
        "label": "THORN: medir deteccion del nombre",
        "detail": "Aciertos y falsas alarmas de «Thorn» con tus grabaciones: gramatica frente a alias.",
        "type": "process",
        "command": "${workspaceFolder:00 - Inicio}/.venv/bin/python",
        "windows": { "command": "${workspaceFolder:00 - Inicio}/.venv/Scripts/python.exe" },
        "args": ["tools/evaluate_wake.py", "${input:manifiestoNombre}"],
        "options": { "cwd": "${workspaceFolder:00 - Inicio}" },
        "group": "test",
        "problemMatcher": []
      },
      {
        "label": "THORN: comparar modelos de dictado",
        "detail": "Error de palabras, tiempo y RAM del modelo Vosk pequeno frente al grande con tus grabaciones.",
        "type": "process",
        "command": "${workspaceFolder:00 - Inicio}/.venv/bin/python",
        "windows": { "command": "${workspaceFolder:00 - Inicio}/.venv/Scripts/python.exe" },
        "args": ["tools/compare_speech.py", "${input:manifiestoDictado}"],
        "options": { "cwd": "${workspaceFolder:00 - Inicio}" },
        "group": "test",
        "problemMatcher": []
      },
      {
        "label": "THORN: evaluar ordenes",
        "detail": "Clasifica las frases de tests/fixtures/intent_cases.json y mide la latencia del reconocedor.",
        "type": "process",
        "command": "${workspaceFolder:00 - Inicio}/.venv/bin/python",
        "windows": { "command": "${workspaceFolder:00 - Inicio}/.venv/Scripts/python.exe" },
        "args": ["tools/evaluate_intents.py"],
        "options": { "cwd": "${workspaceFolder:00 - Inicio}" },
        "group": "test",
        "problemMatcher": []
      },
      {
        "label": "THORN: generar datos de interaccion",
        "detail": "Datos sinteticos train/dev/test del modelo de interaccion en .artifacts/interaction.",
        "type": "process",
        "command": "${workspaceFolder:00 - Inicio}/.venv/bin/python",
        "windows": { "command": "${workspaceFolder:00 - Inicio}/.venv/Scripts/python.exe" },
        "args": ["tools/generate_interaction_data.py"],
        "options": { "cwd": "${workspaceFolder:00 - Inicio}" },
        "problemMatcher": []
      },
      {
        "label": "THORN: evaluar modelo de interaccion",
        "detail": "Reglas frente a un modelo de Ollama en el conjunto de prueba (necesita Ollama en marcha).",
        "type": "process",
        "command": "${workspaceFolder:00 - Inicio}/.venv/bin/python",
        "windows": { "command": "${workspaceFolder:00 - Inicio}/.venv/Scripts/python.exe" },
        "args": ["tools/evaluate_interaction.py", "--modelo", "${input:modeloInteraccion}", "--limite", "150"],
        "options": { "cwd": "${workspaceFolder:00 - Inicio}" },
        "group": "test",
        "problemMatcher": []
      },
      {
        "label": "THORN: evaluar modelo propio de interaccion",
        "detail": "Modelo entrenado servido en Ollama con gramatica, protegido e hibrido, en las frases escritas a mano.",
        "type": "process",
        "command": "${workspaceFolder:00 - Inicio}/.venv/bin/python",
        "windows": { "command": "${workspaceFolder:00 - Inicio}/.venv/Scripts/python.exe" },
        "args": ["tools/evaluate_interaction.py", "--modelo", "${input:modeloPropio}", "--entrenado", "--hibrido",
                 "--conjunto", "holdout"],
        "options": { "cwd": "${workspaceFolder:00 - Inicio}" },
        "group": "test",
        "problemMatcher": []
      },
      {
        "label": "THORN: grabar tus frases para la prueba ciega",
        "detail": "Dices cada frase al microfono, Vosk la transcribe y tu eliges que debia hacer Thorn. Guarda tu voz en .artifacts/voz-real.",
        "type": "process",
        "command": "${workspaceFolder:00 - Inicio}/.venv/bin/python",
        "windows": { "command": "${workspaceFolder:00 - Inicio}/.venv/Scripts/python.exe" },
        "args": ["tools/record_interaction_phrases.py", "--salida", ".artifacts/voz-real/${input:loteVoz}"],
        "options": { "cwd": "${workspaceFolder:00 - Inicio}" },
        "presentation": { "focus": true, "panel": "dedicated" },
        "problemMatcher": []
      },
      {
        "label": "THORN: evaluar con tus frases grabadas",
        "detail": "Modelo propio protegido frente a las reglas con lo que oyo Vosk de tus frases (necesita Ollama).",
        "type": "process",
        "command": "${workspaceFolder:00 - Inicio}/.venv/bin/python",
        "windows": { "command": "${workspaceFolder:00 - Inicio}/.venv/Scripts/python.exe" },
        "args": ["tools/evaluate_interaction.py", "--modelo", "${input:modeloPropio}", "--entrenado",
                 "--conjunto", "voz", "--frases", ".artifacts/voz-real/${input:loteVoz}/frases.json"],
        "options": { "cwd": "${workspaceFolder:00 - Inicio}" },
        "group": "test",
        "problemMatcher": []
      },
      {
        "label": "THORN: prueba de interrupcion (navegador)",
        "detail": "Silero real en Chromium. Requiere el servidor en marcha y antes la tarea «crear audio de prueba».",
        "type": "shell",
        "command": "npm",
        "windows": { "command": "npm.cmd" },
        "args": ["run", "test:bargein"],
        "options": {
          "cwd": "${workspaceFolder:00 - Inicio}/frontend",
          "env": {
            "THORN_TEST_URL": "${input:urlServidor}",
            "THORN_VOICE_FIXTURE_WAV": "${workspaceFolder:00 - Inicio}/.artifacts/frase-prueba.wav"
          }
        },
        "group": "test",
        "problemMatcher": []
      }
    ],
    "inputs": [
      {
        "id": "manifiestoNombre",
        "type": "promptString",
        "description": "Manifiesto JSON con grabaciones del nombre ({\"wav\": \"...\", \"wake\": true|false})",
        "default": ".artifacts/nombre.json"
      },
      {
        "id": "manifiestoDictado",
        "type": "promptString",
        "description": "Manifiesto JSON con grabaciones de dictado ({\"wav\": \"...\", \"text\": \"...\"})",
        "default": ".artifacts/muestras.json"
      },
      {
        "id": "modeloInteraccion",
        "type": "promptString",
        "description": "Modelo de Ollama para el modelo de interaccion",
        "default": "thorn:bastion9"
      },
      {
        "id": "modeloPropio",
        "type": "promptString",
        "description": "Modelo de interaccion propio importado en Ollama",
        "default": "thorn-interaccion:v4-q8"
      },
      {
        "id": "loteVoz",
        "type": "promptString",
        "description": "Lote de frases grabadas en .artifacts/voz-real (uno nuevo para cada prueba ciega)",
        "default": "lote-1"
      },
      {
        "id": "urlServidor",
        "type": "promptString",
        "description": "URL del servidor de Thorn en marcha",
        "default": "http://127.0.0.1:8004"
      }
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "THORN: API de desarrollo (8005)",
        "type": "debugpy",
        "request": "launch",
        "python": "${workspaceFolder:00 - Inicio}/.venv/bin/python",
        "windows": { "python": "${workspaceFolder:00 - Inicio}/.venv/Scripts/python.exe" },
        "program": "${workspaceFolder:00 - Inicio}/serve.py",
        "args": ["--port", "8005", "--sin-db"],
        "cwd": "${workspaceFolder:00 - Inicio}",
        "console": "integratedTerminal",
        "justMyCode": true
      },
      {
        "name": "THORN: demo del nucleo",
        "type": "debugpy",
        "request": "launch",
        "python": "${workspaceFolder:00 - Inicio}/.venv/bin/python",
        "windows": { "python": "${workspaceFolder:00 - Inicio}/.venv/Scripts/python.exe" },
        "program": "${workspaceFolder:00 - Inicio}/main.py",
        "args": ["--demo", "--sin-db"],
        "cwd": "${workspaceFolder:00 - Inicio}",
        "console": "integratedTerminal",
        "justMyCode": true
      }
    ]
  }
}
