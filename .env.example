MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=db_thorn

# Windows: autoridad protegida con DPAPI en data/security; no se copia al HUD.
# Fuera de Windows o en CI se admite una autoridad por variable de proceso.
DJANGO_SECRET_KEY=
THORN_API_TOKEN=
THORN_USE_DATABASE=1
# Activar con tools/migrate_secure_storage.py --apply; requiere Windows DPAPI.
THORN_SECURE_STORAGE=0
# Sensor de solo lectura. Intervalo minimo 0.2 segundos.
THORN_SYSTEM_SENSOR=1
THORN_SENSOR_INTERVAL=2
# Solo IA local: no DNS, proxies ni proveedores remotos.
THORN_LLM_URL=http://127.0.0.1:11434
THORN_LLM_MODEL=thorn:bastion9
# Crea el perfil con tools/install_local_brain.py; reutiliza Qwen instalado.
THORN_BRAIN_AUTOSTART=1
# Bloquea ElevenLabs y Brave aun cuando existan claves guardadas.
THORN_LOCAL_AI_ONLY=1

# Voz local CPU: requirements-voice.txt + tools/install_voice_model.py.
THORN_VOICE_ENABLED=0
THORN_VOICE_PROVIDER=piper
# Compatibilidad opcional con ElevenLabs, inactiva en modo local.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Dictado LOCAL opcional. Instala requirements-speech.txt y el modelo Vosk primero.
# No abre entrada por si solo ni sustituye el permiso del dispositivo.
THORN_MICROPHONE_ENABLED=0
# Escucha local y consultas automaticas al conectar una sesion privada.
# Requiere permiso del navegador; no autoriza voz en la nube.
THORN_CONVERSATION_AUTO_START=0

# Bastion 9: preferencias de saludo, nombre y zona horaria se guardan desde
# Asistente > Herramientas > Preferencias. No guardan permisos de dispositivos.
# La camara se activa a mano por sesion; no tiene arranque automatico.
# Detector opcional: tools/install_vision_model.py y luego npm run build.

# Internet de solo lectura. La UI pide consentimiento independiente por sesion.
THORN_INTERNET_ENABLED=0
# wikipedia = fuente enciclopedica sin clave; brave = busqueda web general.
THORN_SEARCH_PROVIDER=wikipedia
BRAVE_SEARCH_API_KEY=
