# Configuracion privada: solo se comparte la plantilla vacia.
.env
.env.*
!.env.example
*.env

# Entornos y archivos generados por Python.
.venv/
venv/
.tools-venv/
__pycache__/
*.py[cod]
.pytest_cache/
